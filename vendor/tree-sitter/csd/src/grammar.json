{
  "$schema": "https://tree-sitter.github.io/tree-sitter/assets/schemas/grammar.schema.json",
  "name": "csd",
  "rules": {
    "source_file": {
      "type": "REPEAT",
      "content": {
        "type": "CHOICE",
        "members": [
          {
            "type": "SYMBOL",
            "name": "definition"
          },
          {
            "type": "SYMBOL",
            "name": "comment"
          }
        ]
      }
    },
    "comment": {
      "type": "PATTERN",
      "value": "\\/\\*[^\\n]*\\*?\\/?"
    },
    "definition": {
      "type": "CHOICE",
      "members": [
        {
          "type": "SYMBOL",
          "name": "define_file"
        },
        {
          "type": "SYMBOL",
          "name": "define_mapset"
        },
        {
          "type": "SYMBOL",
          "name": "define_program"
        },
        {
          "type": "SYMBOL",
          "name": "define_transaction"
        },
        {
          "type": "SYMBOL",
          "name": "define_tdqueue"
        },
        {
          "type": "SYMBOL",
          "name": "define_tsqueue"
        },
        {
          "type": "SYMBOL",
          "name": "define_connection"
        },
        {
          "type": "SYMBOL",
          "name": "define_sessions"
        },
        {
          "type": "SYMBOL",
          "name": "generic_define"
        }
      ]
    },
    "define_file": {
      "type": "SEQ",
      "members": [
        {
          "type": "STRING",
          "value": "DEFINE"
        },
        {
          "type": "STRING",
          "value": "FILE"
        },
        {
          "type": "STRING",
          "value": "("
        },
        {
          "type": "SYMBOL",
          "name": "resource_name"
        },
        {
          "type": "STRING",
          "value": ")"
        },
        {
          "type": "REPEAT",
          "content": {
            "type": "SYMBOL",
            "name": "attribute"
          }
        }
      ]
    },
    "define_mapset": {
      "type": "SEQ",
      "members": [
        {
          "type": "STRING",
          "value": "DEFINE"
        },
        {
          "type": "STRING",
          "value": "MAPSET"
        },
        {
          "type": "STRING",
          "value": "("
        },
        {
          "type": "SYMBOL",
          "name": "resource_name"
        },
        {
          "type": "STRING",
          "value": ")"
        },
        {
          "type": "REPEAT",
          "content": {
            "type": "SYMBOL",
            "name": "attribute"
          }
        }
      ]
    },
    "define_program": {
      "type": "SEQ",
      "members": [
        {
          "type": "STRING",
          "value": "DEFINE"
        },
        {
          "type": "STRING",
          "value": "PROGRAM"
        },
        {
          "type": "STRING",
          "value": "("
        },
        {
          "type": "SYMBOL",
          "name": "resource_name"
        },
        {
          "type": "STRING",
          "value": ")"
        },
        {
          "type": "REPEAT",
          "content": {
            "type": "SYMBOL",
            "name": "attribute"
          }
        }
      ]
    },
    "define_transaction": {
      "type": "SEQ",
      "members": [
        {
          "type": "STRING",
          "value": "DEFINE"
        },
        {
          "type": "STRING",
          "value": "TRANSACTION"
        },
        {
          "type": "STRING",
          "value": "("
        },
        {
          "type": "SYMBOL",
          "name": "resource_name"
        },
        {
          "type": "STRING",
          "value": ")"
        },
        {
          "type": "REPEAT",
          "content": {
            "type": "SYMBOL",
            "name": "attribute"
          }
        }
      ]
    },
    "define_tdqueue": {
      "type": "SEQ",
      "members": [
        {
          "type": "STRING",
          "value": "DEFINE"
        },
        {
          "type": "STRING",
          "value": "TDQUEUE"
        },
        {
          "type": "STRING",
          "value": "("
        },
        {
          "type": "SYMBOL",
          "name": "resource_name"
        },
        {
          "type": "STRING",
          "value": ")"
        },
        {
          "type": "REPEAT",
          "content": {
            "type": "SYMBOL",
            "name": "attribute"
          }
        }
      ]
    },
    "define_tsqueue": {
      "type": "SEQ",
      "members": [
        {
          "type": "STRING",
          "value": "DEFINE"
        },
        {
          "type": "CHOICE",
          "members": [
            {
              "type": "STRING",
              "value": "TSQUEUE"
            },
            {
              "type": "STRING",
              "value": "TSMODEL"
            }
          ]
        },
        {
          "type": "STRING",
          "value": "("
        },
        {
          "type": "SYMBOL",
          "name": "resource_name"
        },
        {
          "type": "STRING",
          "value": ")"
        },
        {
          "type": "REPEAT",
          "content": {
            "type": "SYMBOL",
            "name": "attribute"
          }
        }
      ]
    },
    "define_connection": {
      "type": "SEQ",
      "members": [
        {
          "type": "STRING",
          "value": "DEFINE"
        },
        {
          "type": "STRING",
          "value": "CONNECTION"
        },
        {
          "type": "STRING",
          "value": "("
        },
        {
          "type": "SYMBOL",
          "name": "resource_name"
        },
        {
          "type": "STRING",
          "value": ")"
        },
        {
          "type": "REPEAT",
          "content": {
            "type": "SYMBOL",
            "name": "attribute"
          }
        }
      ]
    },
    "define_sessions": {
      "type": "SEQ",
      "members": [
        {
          "type": "STRING",
          "value": "DEFINE"
        },
        {
          "type": "STRING",
          "value": "SESSIONS"
        },
        {
          "type": "STRING",
          "value": "("
        },
        {
          "type": "SYMBOL",
          "name": "resource_name"
        },
        {
          "type": "STRING",
          "value": ")"
        },
        {
          "type": "REPEAT",
          "content": {
            "type": "SYMBOL",
            "name": "attribute"
          }
        }
      ]
    },
    "generic_define": {
      "type": "SEQ",
      "members": [
        {
          "type": "STRING",
          "value": "DEFINE"
        },
        {
          "type": "SYMBOL",
          "name": "resource_type"
        },
        {
          "type": "CHOICE",
          "members": [
            {
              "type": "SEQ",
              "members": [
                {
                  "type": "STRING",
                  "value": "("
                },
                {
                  "type": "SYMBOL",
                  "name": "resource_name"
                },
                {
                  "type": "STRING",
                  "value": ")"
                }
              ]
            },
            {
              "type": "BLANK"
            }
          ]
        },
        {
          "type": "REPEAT",
          "content": {
            "type": "SYMBOL",
            "name": "attribute"
          }
        }
      ]
    },
    "attribute": {
      "type": "CHOICE",
      "members": [
        {
          "type": "SEQ",
          "members": [
            {
              "type": "STRING",
              "value": "DESCRIPTION"
            },
            {
              "type": "STRING",
              "value": "("
            },
            {
              "type": "SYMBOL",
              "name": "description_text"
            },
            {
              "type": "STRING",
              "value": ")"
            }
          ]
        },
        {
          "type": "SEQ",
          "members": [
            {
              "type": "STRING",
              "value": "GROUP"
            },
            {
              "type": "STRING",
              "value": "("
            },
            {
              "type": "SYMBOL",
              "name": "group_name"
            },
            {
              "type": "STRING",
              "value": ")"
            }
          ]
        },
        {
          "type": "SEQ",
          "members": [
            {
              "type": "SYMBOL",
              "name": "attribute_name"
            },
            {
              "type": "STRING",
              "value": "("
            },
            {
              "type": "SYMBOL",
              "name": "attribute_value"
            },
            {
              "type": "STRING",
              "value": ")"
            }
          ]
        },
        {
          "type": "SYMBOL",
          "name": "attribute_name"
        }
      ]
    },
    "attribute_name": {
      "type": "PATTERN",
      "value": "[A-Z][A-Z0-9]*"
    },
    "attribute_value": {
      "type": "CHOICE",
      "members": [
        {
          "type": "SYMBOL",
          "name": "datetime"
        },
        {
          "type": "SYMBOL",
          "name": "number_list"
        },
        {
          "type": "SYMBOL",
          "name": "dataset_name"
        },
        {
          "type": "SYMBOL",
          "name": "number"
        },
        {
          "type": "SYMBOL",
          "name": "identifier"
        },
        {
          "type": "SYMBOL",
          "name": "yes_no"
        }
      ]
    },
    "number_list": {
      "type": "SEQ",
      "members": [
        {
          "type": "SYMBOL",
          "name": "number"
        },
        {
          "type": "REPEAT1",
          "content": {
            "type": "SEQ",
            "members": [
              {
                "type": "STRING",
                "value": ","
              },
              {
                "type": "SYMBOL",
                "name": "number"
              }
            ]
          }
        }
      ]
    },
    "description_text": {
      "type": "PATTERN",
      "value": "[A-Z0-9 _\\-]+"
    },
    "group_name": {
      "type": "PATTERN",
      "value": "[A-Z][A-Z0-9]*"
    },
    "resource_type": {
      "type": "PATTERN",
      "value": "[A-Z][A-Z0-9]*"
    },
    "resource_name": {
      "type": "PATTERN",
      "value": "[A-Z][A-Z0-9]*"
    },
    "dataset_name": {
      "type": "PATTERN",
      "value": "[A-Z][A-Z0-9]*(\\.[A-Z0-9]+)*"
    },
    "datetime": {
      "type": "PATTERN",
      "value": "\\d{2}\\/\\d{2}\\/\\d{2}[ ]\\d{2}:\\d{2}:\\d{2}"
    },
    "number": {
      "type": "PATTERN",
      "value": "\\d+"
    },
    "identifier": {
      "type": "PATTERN",
      "value": "[A-Z][A-Z0-9]*"
    },
    "yes_no": {
      "type": "CHOICE",
      "members": [
        {
          "type": "STRING",
          "value": "YES"
        },
        {
          "type": "STRING",
          "value": "NO"
        }
      ]
    }
  },
  "extras": [
    {
      "type": "PATTERN",
      "value": "[ \\t]+"
    },
    {
      "type": "PATTERN",
      "value": "\\r?\\n"
    }
  ],
  "conflicts": [],
  "precedences": [],
  "externals": [],
  "inline": [],
  "supertypes": []
}
