{
  "grammars": [
    {
      "name": "csd",
      "camelcase": "Csd",
      "scope": "source.csd",
      "path": ".",
      "file-types": [
        "csd"
      ],
      "injection-regex": "csd"
    }
  ],
  "metadata": {
    "version": "1.0.0",
    "license": "MIT",
    "description": "Tree-sitter grammar for CICS System Definition (CSD) files",
    "links": {
      "repository": "https://github.com/tree-sitter/tree-sitter-csd"
    }
  },
  "bindings": {
    "c": true,
    "go": true,
    "node": true,
    "python": true,
    "rust": true,
    "swift": true
  }
}