{
  "grammars": [
    {
      "name": "jcl",
      "camelcase": "Jcl",
      "scope": "source.jcl",
      "path": ".",
      "file-types": [
        "jcl",
        "job",
        "proc",
        "prc"
      ]
    }
  ],
  "metadata": {
    "version": "0.1.0",
    "license": "MIT",
    "description": "Tree-sitter grammar for JCL (Job Control Language)",
    "links": {
      "repository": "https://github.com/yourusername/tree-sitter-jcl.git"
    }
  },
  "bindings": {
    "c": true,
    "go": true,
    "node": true,
    "python": true,
    "rust": true,
    "swift": true
  }
}