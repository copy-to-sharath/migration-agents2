{
  "$schema": "https://tree-sitter.github.io/tree-sitter/assets/schemas/grammar.schema.json",
  "name": "bms",
  "rules": {
    "source_file": {
      "type": "REPEAT",
      "content": {
        "type": "CHOICE",
        "members": [
          {
            "type": "SYMBOL",
            "name": "bms_statement"
          },
          {
            "type": "SYMBOL",
            "name": "end_statement"
          },
          {
            "type": "SYMBOL",
            "name": "comment"
          },
          {
            "type": "SYMBOL",
            "name": "blank_line"
          }
        ]
      }
    },
    "bms_statement": {
      "type": "SEQ",
      "members": [
        {
          "type": "CHOICE",
          "members": [
            {
              "type": "SYMBOL",
              "name": "label"
            },
            {
              "type": "BLANK"
            }
          ]
        },
        {
          "type": "SYMBOL",
          "name": "macro_name"
        },
        {
          "type": "CHOICE",
          "members": [
            {
              "type": "SYMBOL",
              "name": "parameters"
            },
            {
              "type": "BLANK"
            }
          ]
        },
        {
          "type": "SYMBOL",
          "name": "_eol"
        }
      ]
    },
    "end_statement": {
      "type": "SEQ",
      "members": [
        {
          "type": "CHOICE",
          "members": [
            {
              "type": "SYMBOL",
              "name": "label"
            },
            {
              "type": "BLANK"
            }
          ]
        },
        {
          "type": "PATTERN",
          "value": "END",
          "flags": "i"
        },
        {
          "type": "SYMBOL",
          "name": "_eol"
        }
      ]
    },
    "label": {
      "type": "PATTERN",
      "value": "[A-Z@#$][A-Z0-9@#$]*",
      "flags": "i"
    },
    "macro_name": {
      "type": "CHOICE",
      "members": [
        {
          "type": "PATTERN",
          "value": "DFHMSD",
          "flags": "i"
        },
        {
          "type": "PATTERN",
          "value": "DFHMDI",
          "flags": "i"
        },
        {
          "type": "PATTERN",
          "value": "DFHMDF",
          "flags": "i"
        }
      ]
    },
    "parameters": {
      "type": "REPEAT1",
      "content": {
        "type": "SYMBOL",
        "name": "parameter"
      }
    },
    "parameter": {
      "type": "SEQ",
      "members": [
        {
          "type": "SYMBOL",
          "name": "param_name"
        },
        {
          "type": "STRING",
          "value": "="
        },
        {
          "type": "CHOICE",
          "members": [
            {
              "type": "SYMBOL",
              "name": "param_list"
            },
            {
              "type": "SYMBOL",
              "name": "param_value"
            }
          ]
        },
        {
          "type": "CHOICE",
          "members": [
            {
              "type": "STRING",
              "value": ","
            },
            {
              "type": "BLANK"
            }
          ]
        }
      ]
    },
    "param_name": {
      "type": "PATTERN",
      "value": "[A-Z][A-Z0-9]*",
      "flags": "i"
    },
    "param_list": {
      "type": "SEQ",
      "members": [
        {
          "type": "STRING",
          "value": "("
        },
        {
          "type": "SYMBOL",
          "name": "param_value"
        },
        {
          "type": "REPEAT",
          "content": {
            "type": "SEQ",
            "members": [
              {
                "type": "STRING",
                "value": ","
              },
              {
                "type": "SYMBOL",
                "name": "param_value"
              }
            ]
          }
        },
        {
          "type": "STRING",
          "value": ")"
        }
      ]
    },
    "param_value": {
      "type": "CHOICE",
      "members": [
        {
          "type": "SYMBOL",
          "name": "string_literal"
        },
        {
          "type": "SYMBOL",
          "name": "hex_literal"
        },
        {
          "type": "SYMBOL",
          "name": "number"
        },
        {
          "type": "SYMBOL",
          "name": "identifier"
        }
      ]
    },
    "identifier": {
      "type": "PATTERN",
      "value": "[A-Z@#$][A-Z0-9@#$-]*",
      "flags": "i"
    },
    "string_literal": {
      "type": "PATTERN",
      "value": "'[^']*'"
    },
    "hex_literal": {
      "type": "PATTERN",
      "value": "X'[0-9A-Fa-f]+'",
      "flags": "i"
    },
    "number": {
      "type": "PATTERN",
      "value": "-?\\d+"
    },
    "comment": {
      "type": "SEQ",
      "members": [
        {
          "type": "STRING",
          "value": "*"
        },
        {
          "type": "PATTERN",
          "value": "[^\\n]*"
        },
        {
          "type": "SYMBOL",
          "name": "_eol"
        }
      ]
    },
    "blank_line": {
      "type": "SYMBOL",
      "name": "_eol"
    },
    "_eol": {
      "type": "PATTERN",
      "value": "\\r?\\n"
    }
  },
  "extras": [
    {
      "type": "PATTERN",
      "value": "[ \\t]"
    }
  ],
  "conflicts": [],
  "precedences": [],
  "externals": [],
  "inline": [],
  "supertypes": [],
  "reserved": {}
}