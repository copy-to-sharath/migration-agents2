{
  "grammars": [
    {
      "name": "idcams",
      "camelcase": "Idcams",
      "scope": "source.idcams",
      "path": ".",
      "file-types": [
        "ctl",
        "ams"
      ],
      "injection-regex": "idcams"
    }
  ],
  "metadata": {
    "version": "1.0.0",
    "license": "MIT",
    "description": "Tree-sitter grammar for IBM IDCAMS (Access Method Services)",
    "links": {
      "repository": "https://github.com/tree-sitter/tree-sitter-idcams"
    }
  },
  "bindings": {
    "c": true,
    "go": true,
    "node": true,
    "python": true,
    "rust": true,
    "swift": true
  }
}