{
  "$schema": "https://tree-sitter.github.io/tree-sitter/assets/schemas/grammar.schema.json",
  "name": "idcams",
  "rules": {
    "source_file": {
      "type": "REPEAT",
      "content": {
        "type": "CHOICE",
        "members": [
          {
            "type": "SYMBOL",
            "name": "statement"
          },
          {
            "type": "SYMBOL",
            "name": "comment"
          }
        ]
      }
    },
    "comment": {
      "type": "PATTERN",
      "value": "\\/\\*[^\\n]*\\*?\\/?"
    },
    "statement": {
      "type": "SEQ",
      "members": [
        {
          "type": "SYMBOL",
          "name": "command"
        },
        {
          "type": "REPEAT",
          "content": {
            "type": "SYMBOL",
            "name": "parameter"
          }
        }
      ]
    },
    "command": {
      "type": "CHOICE",
      "members": [
        {
          "type": "STRING",
          "value": "REPRO"
        },
        {
          "type": "STRING",
          "value": "DEFINE"
        },
        {
          "type": "STRING",
          "value": "DELETE"
        },
        {
          "type": "STRING",
          "value": "PRINT"
        },
        {
          "type": "STRING",
          "value": "LISTCAT"
        },
        {
          "type": "STRING",
          "value": "SET"
        },
        {
          "type": "STRING",
          "value": "VERIFY"
        },
        {
          "type": "STRING",
          "value": "ALTER"
        },
        {
          "type": "STRING",
          "value": "BLDINDEX"
        },
        {
          "type": "STRING",
          "value": "EXPORT"
        },
        {
          "type": "STRING",
          "value": "IMPORT"
        },
        {
          "type": "SYMBOL",
          "name": "identifier"
        }
      ]
    },
    "parameter": {
      "type": "CHOICE",
      "members": [
        {
          "type": "SYMBOL",
          "name": "keyword_param"
        },
        {
          "type": "SYMBOL",
          "name": "continuation"
        }
      ]
    },
    "keyword_param": {
      "type": "SEQ",
      "members": [
        {
          "type": "SYMBOL",
          "name": "keyword"
        },
        {
          "type": "CHOICE",
          "members": [
            {
              "type": "SEQ",
              "members": [
                {
                  "type": "STRING",
                  "value": "("
                },
                {
                  "type": "CHOICE",
                  "members": [
                    {
                      "type": "SYMBOL",
                      "name": "param_content"
                    },
                    {
                      "type": "BLANK"
                    }
                  ]
                },
                {
                  "type": "STRING",
                  "value": ")"
                }
              ]
            },
            {
              "type": "BLANK"
            }
          ]
        }
      ]
    },
    "param_content": {
      "type": "REPEAT1",
      "content": {
        "type": "CHOICE",
        "members": [
          {
            "type": "SYMBOL",
            "name": "nested_paren"
          },
          {
            "type": "SYMBOL",
            "name": "dataset_name"
          },
          {
            "type": "SYMBOL",
            "name": "number"
          },
          {
            "type": "SYMBOL",
            "name": "keyword"
          },
          {
            "type": "STRING",
            "value": ","
          }
        ]
      }
    },
    "nested_paren": {
      "type": "SEQ",
      "members": [
        {
          "type": "STRING",
          "value": "("
        },
        {
          "type": "CHOICE",
          "members": [
            {
              "type": "SYMBOL",
              "name": "param_content"
            },
            {
              "type": "BLANK"
            }
          ]
        },
        {
          "type": "STRING",
          "value": ")"
        }
      ]
    },
    "continuation": {
      "type": "STRING",
      "value": "-"
    },
    "keyword": {
      "type": "PATTERN",
      "value": "[A-Z][A-Z0-9]*"
    },
    "identifier": {
      "type": "PATTERN",
      "value": "[A-Z][A-Z0-9]*"
    },
    "dataset_name": {
      "type": "PATTERN",
      "value": "[A-Z][A-Z0-9]*\\.[A-Z0-9]+(\\.[A-Z0-9]+)*"
    },
    "number": {
      "type": "PATTERN",
      "value": "\\d+"
    }
  },
  "extras": [
    {
      "type": "PATTERN",
      "value": "[ \\t]+"
    },
    {
      "type": "PATTERN",
      "value": "\\r?\\n"
    }
  ],
  "conflicts": [
    [
      "statement"
    ]
  ],
  "precedences": [],
  "externals": [],
  "inline": [],
  "supertypes": []
}
